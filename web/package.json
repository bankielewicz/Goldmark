{
  "name": "goldmark-web",
  "version": "0.0.0",
  "private": true,
  "description": "Goldmark browser-only SPA (React + TypeScript + Vite). No Node.js at runtime.",
  "type": "module",
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.28.5"
  },
  "scripts": {
    "policy": "node scripts/check-dependency-policy.mjs",
    "test:policy": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "test:dist": "node --test \"tests/*.test.mjs\"",
    "test": "pnpm run test:policy && pnpm run test:dist",
    "e2e": "playwright test",
    "dev": "vite",
    "policy:installed": "node scripts/check-installed-tree.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.344",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}

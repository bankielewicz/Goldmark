# Goldmark deployment settings, for either Compose file:
#   deploy/docker-compose.yml               Goldmark + bundled SQL Server 2025 Express
#   deploy/docker-compose.external-sql.yml  Goldmark + an existing SQL Server 2025
#                                           (docs/ops/external-sql-server.md)
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Never commit deploy/.env. There are no default passwords: every REQUIRED
# value below is empty on purpose and Compose refuses to start until it is set.
# Generate strong secrets, for example:  openssl rand -base64 30
#
# SQL Server password rules: at least 8 characters from three of: upper case,
# lower case, digits, symbols. The Goldmark runtime and migration passwords must
# be 12-128 characters, and all three passwords must differ. Avoid the
# characters $ and ` (Compose interpolation).

# --- SQL Server 2025 Express (bundled; docker-compose.yml only) ----------------

# REQUIRED. Set to Y to accept the SQL Server Express license terms
# (https://go.microsoft.com/fwlink/?linkid=857698). Goldmark cannot accept them for you.
SQLSERVER_ACCEPT_EULA=

# REQUIRED. Password for the SQL Server 'sa' login. Used only by the SQL Server
# container and by the one-shot db-init container; never given to the app.
SQLSERVER_SA_PASSWORD=

# Optional. Memory cap for SQL Server in MB (Express uses at most ~1.4 GB of buffer pool).
SQLSERVER_MEMORY_LIMIT_MB=2048

# --- Goldmark database login ---------------------------------------------------

# Optional. Name of the least-privilege runtime login that db-init creates
# (letters, digits, underscore; not 'sa' or a reserved name such as dbo, guest,
# sys, public). The app uses only this login: DML on Goldmark's tables, no DDL,
# and no UPDATE or DELETE on the audit log.
GOLDMARK_DB_USER=goldmark_app

# REQUIRED. Password for the runtime login.
GOLDMARK_DB_PASSWORD=

# Optional. Name of the migration login that db-init creates and uses to apply
# schema migrations. It is db_owner of the Goldmark database only (no server
# roles). Only the one-shot db-init container receives it, never the app.
GOLDMARK_DB_MIGRATION_USER=goldmark_migrator

# REQUIRED. Password for the migration login (12-128 characters). Must differ
# from GOLDMARK_DB_PASSWORD and SQLSERVER_SA_PASSWORD.
GOLDMARK_DB_MIGRATION_PASSWORD=

# Changing GOLDMARK_DB_PASSWORD or GOLDMARK_DB_MIGRATION_PASSWORD and running
# `docker compose up -d` rotates the password of the login Goldmark created.

# Optional. Principal-audit findings about a shared SQL Server that you accept,
# by ID, separated by commas or spaces (for example guest-connect:Sales). db-init
# audits the instance and both logins on every run and refuses (exit 3) on any
# finding; each refusal names the finding's ID and how to fix it. Only findings
# about other databases or the instance can be accepted, never findings about
# Goldmark's own logins or database. See docs/ops/external-sql-server.md.
GOLDMARK_DB_ACCEPTED_FINDINGS=

# Optional. db-init only manages logins and database users it created itself.
# If GOLDMARK_DB_USER or GOLDMARK_DB_MIGRATION_USER names a login or database
# user that already exists and was not created by Goldmark, db-init refuses and
# changes nothing. Set this to true to take it over instead: its password is set
# to the configured one and it is marked as managed. The runtime login must still
# hold nothing beyond CONNECT and the goldmark_runtime role; the migration login
# nothing beyond db_owner of the Goldmark database.
GOLDMARK_DB_ADOPT_EXISTING_LOGIN=false

# --- Existing SQL Server (docker-compose.external-sql.yml only) ----------------
# The bundled SQL Server settings above are not used. The runtime and migration
# login settings above apply to both files.

# REQUIRED (external). Host name or IP address of the SQL Server 2025 instance.
GOLDMARK_DB_HOST=

# Optional. TCP port and database name.
GOLDMARK_DB_PORT=1433
GOLDMARK_DB_NAME=Goldmark

# REQUIRED (external). Administrator login for db-init only: it needs CONTROL
# SERVER (for example sysadmin) to audit the instance and, in Mode Create, to
# create the database and both logins. 'sa' is refused: create a dedicated login.
# The app container never receives it.
GOLDMARK_DB_ADMIN_USER=
GOLDMARK_DB_ADMIN_PASSWORD=

# Optional. Create (default): db-init creates the database and both logins if
# they are missing. Existing: a DBA has created the database, both logins (with
# the passwords above), their users and the migration login's db_owner
# membership; db-init creates and changes nothing except Goldmark's marker on
# the two users. The script for the DBA is in docs/ops/external-sql-server.md.
GOLDMARK_DB_BOOTSTRAP_MODE=Create

# Optional. Strict (default, TDS 8) or Mandatory (TLS-encrypted TDS 7.x, for
# servers that do not accept strict connections). Unencrypted is not supported.
GOLDMARK_DB_ENCRYPT=Strict

# Optional. Host path of the SQL Server's certificate (PEM or DER) to pin, for
# example a self-signed or internal-CA certificate. Use an absolute path, or one
# starting with ./ (relative to deploy/). Empty: the certificate must chain to a
# public CA the container trusts. TrustServerCertificate is never used.
GOLDMARK_SQL_SERVER_CERT_FILE=

# Optional. Name to validate in the SQL Server certificate when it differs from
# GOLDMARK_DB_HOST (for example when connecting by IP address).
GOLDMARK_DB_HOST_NAME_IN_CERTIFICATE=

# Optional. Seconds db-init waits for SQL Server to accept connections.
GOLDMARK_DB_WAIT_SECONDS=120

# --- HTTPS ---------------------------------------------------------------------

# Optional. Host port for HTTPS (the container listens on 8443).
GOLDMARK_HTTPS_PORT=8443

# Optional. Comma-separated DNS names and IP addresses that users will type in
# the browser. Used for the self-signed certificate generated on first start.
# Changing this regenerates that certificate. See docs/ops/tls-certificates.md.
GOLDMARK_TLS_HOSTNAMES=localhost

# Optional. Your own certificate instead of the generated one: PEM files at
# these paths INSIDE the container (mount them with a Compose override file;
# see docs/ops/tls-certificates.md). Set both or neither.
GOLDMARK_TLS_CERT_FILE=
GOLDMARK_TLS_KEY_FILE=

# Optional. HSTS. Empty = automatic: on when GOLDMARK_TLS_CERT_FILE is set,
# off with the self-signed certificate. true/false forces it. See docs/ops/hsts.md.
GOLDMARK_HSTS_ENABLED=
GOLDMARK_HSTS_MAX_AGE_DAYS=365

# --- Operations ----------------------------------------------------------------

# Optional. Verbose, Debug, Information, Warning, Error or Fatal.
# Host names of your estate only appear at Debug or below.
GOLDMARK_LOG_LEVEL=Information

# Optional. Tag of the locally built image.
GOLDMARK_IMAGE_TAG=local

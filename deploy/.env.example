# Goldmark deployment settings for deploy/docker-compose.yml.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Never commit deploy/.env. There are no default passwords: every REQUIRED
# value below is empty on purpose and Compose refuses to start until it is set.
# Generate strong secrets, for example:  openssl rand -base64 30
#
# SQL Server password rules: at least 8 characters from three of: upper case,
# lower case, digits, symbols. The Goldmark runtime password must be 12-128
# characters. Avoid the characters $ and ` (Compose interpolation).

# --- SQL Server 2025 Express (bundled) ----------------------------------------

# REQUIRED. Set to Y to accept the SQL Server Express license terms
# (https://go.microsoft.com/fwlink/?linkid=857698). Goldmark cannot accept them for you.
SQLSERVER_ACCEPT_EULA=

# REQUIRED. Password for the SQL Server 'sa' login. Used only by the SQL Server
# container and by the one-shot db-init container; never given to the app.
SQLSERVER_SA_PASSWORD=

# Optional. Memory cap for SQL Server in MB (Express uses at most ~1.4 GB of buffer pool).
SQLSERVER_MEMORY_LIMIT_MB=2048

# --- Goldmark database login ---------------------------------------------------

# Optional. Name of the least-privilege runtime login that db-init creates
# (letters, digits, underscore; never 'sa').
GOLDMARK_DB_USER=goldmark_app

# REQUIRED. Password for the runtime login.
GOLDMARK_DB_PASSWORD=

# Changing GOLDMARK_DB_PASSWORD and running `docker compose up -d` rotates the
# password of the login Goldmark created.

# Optional. db-init only manages a login and database user it created itself.
# If GOLDMARK_DB_USER names a login or database user that already exists and
# was not created by Goldmark, db-init refuses and changes nothing. Set this to
# true to take it over instead: its password is set to GOLDMARK_DB_PASSWORD and
# it is marked as managed. The login must still hold nothing beyond CONNECT.
GOLDMARK_DB_ADOPT_EXISTING_LOGIN=false

# --- HTTPS ---------------------------------------------------------------------

# Optional. Host port for HTTPS (the container listens on 8443).
GOLDMARK_HTTPS_PORT=8443

# Optional. Comma-separated DNS names and IP addresses that users will type in
# the browser. Used for the self-signed certificate generated on first start.
# Changing this regenerates that certificate. See docs/ops/tls-certificates.md.
GOLDMARK_TLS_HOSTNAMES=localhost

# Optional. Your own certificate instead of the generated one: PEM files at
# these paths INSIDE the container (mount them with a Compose override file;
# see docs/ops/tls-certificates.md). Set both or neither.
GOLDMARK_TLS_CERT_FILE=
GOLDMARK_TLS_KEY_FILE=

# Optional. HSTS. Empty = automatic: on when GOLDMARK_TLS_CERT_FILE is set,
# off with the self-signed certificate. true/false forces it. See docs/ops/hsts.md.
GOLDMARK_HSTS_ENABLED=
GOLDMARK_HSTS_MAX_AGE_DAYS=365

# --- Operations ----------------------------------------------------------------

# Optional. Verbose, Debug, Information, Warning, Error or Fatal.
# Host names of your estate only appear at Debug or below.
GOLDMARK_LOG_LEVEL=Information

# Optional. Tag of the locally built image.
GOLDMARK_IMAGE_TAG=local

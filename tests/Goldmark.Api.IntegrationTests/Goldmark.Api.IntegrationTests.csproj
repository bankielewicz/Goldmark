<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests against a real SQL Server 2025 container (Testcontainers), using the
    same image digest as deploy/docker-compose.yml. Requires a Docker daemon. Kept apart from
    Goldmark.Api.Tests so the in-process tests stay fast and need no Docker.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Goldmark.Api.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosts the app in-process against the container (sign-in, setup and user flows, slice 3). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Goldmark.Api\Goldmark.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Goldmark.Api</RootNamespace>
    <AssemblyName>Goldmark.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>goldmark-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!--
      Security pin: Microsoft.Data.SqlClient 7.1.1 depends on
      System.Security.Cryptography.Pkcs 9.0.18, which has known vulnerabilities
      (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). 10.0.13 is the
      first fixed version. Remove this pin when SqlClient depends on a fixed
      version. See docs/DECISIONS.md DEC-010.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Goldmark.Api.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Goldmark.Api</RootNamespace>
    <AssemblyName>Goldmark.Api</AssemblyName>
    <UserSecretsId>goldmark-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!--
      Security pin: Microsoft.Data.SqlClient 7.1.1 depends on
      System.Security.Cryptography.Pkcs 9.0.18, which has known vulnerabilities
      (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). 10.0.13 is the
      first fixed version. Remove this pin when SqlClient depends on a fixed
      version. See docs/DECISIONS.md DEC-010.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Forward-only migrations (db/migrations), applied by the migrate command. The logical
         name is what DbUp records in its journal; never rename an applied script. -->
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="Goldmark.Migrations.%(Filename)%(Extension)" />
    <!-- Measured grants to public/guest in the SQL Server 2025 system databases (principal audit, DEC-031). -->
    <EmbeddedResource Include="Commands\Audit\sql-server-2025-public-grants.txt" LogicalName="Goldmark.Audit.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Goldmark.Api.Tests" />
    <InternalsVisibleTo Include="Goldmark.Api.IntegrationTests" />
  </ItemGroup>

</Project>

# Allow-list build context: only what the Dockerfile needs is sent to the
# builder, so local secrets (.env, keys) can never end up in an image layer.
*
!global.json
!NuGet.config
!Directory.Build.props
!Directory.Packages.props
!.editorconfig
!src/
!web/
src/**/bin/
src/**/obj/
web/node_modules/
web/dist/
web/playwright-report/
web/test-results/
**/.env
**/.env.*
**/*.pfx
**/*.key
**/*.pem
